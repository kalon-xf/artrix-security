# Enable only for local development. Demo mode never runs in production.
ARTRIX_DEMO_MODE=true

# Required when replacing the local demo store with PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artrix

# Public origin used for links and CSRF-safe same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configure an authentication provider before production.
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
